# URL da API. Em device físico/emulador use o IP da máquina na rede local, não localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# Modo demo: responde todas as chamadas com dados falsos em memória (src/mocks), sem API.
# Depois de mudar, reinicie com `npx expo start -c`.
EXPO_PUBLIC_USE_MOCKS=false

# Google Sign-In (ver docs/adr/002-auth-integration.md)
# Client ID do tipo "Web" — o mesmo GOOGLE_CLIENT_ID da API (é a audience do idToken)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Client ID do tipo "iOS"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, usado no build nativo (com.googleusercontent.apps.xxxx)
GOOGLE_IOS_URL_SCHEME=
