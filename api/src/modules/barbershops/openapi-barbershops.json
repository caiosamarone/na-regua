{
  "openapi": "3.1.0",
  "info": {
    "title": "barbershops",
    "description": "Endpoints de barbearias (Fase 2). Inclui customização (cores, redes sociais) e galeria de imagens. Use <<SERVER_URL>> como variável de ambiente no Hoppscotch.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "<<SERVER_URL>>",
      "description": "Base URL configurada no Hoppscotch"
    }
  ],
  "paths": {
    "/barbershops/search": {
      "get": {
        "summary": "Buscar barbearias (texto + localização)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "lat",
            "in": "query",
            "schema": { "type": "number" }
          },
          {
            "name": "lng",
            "in": "query",
            "schema": { "type": "number" }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "schema": { "type": "number" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de barbearias" }
        }
      }
    },
    "/barbershops/{slugOrId}": {
      "get": {
        "summary": "Perfil da barbearia",
        "parameters": [
          {
            "name": "slugOrId",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Perfil completo" }
        }
      }
    },
    "/barbershops/{id}/staff/bookable": {
      "get": {
        "summary": "Listar staff bookable",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de staff disponível" }
        }
      }
    },
    "/barbershops/{id}/services": {
      "get": {
        "summary": "Listar serviços ativos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de serviços" }
        }
      }
    },
    "/barbershops": {
      "post": {
        "summary": "Criar barbearia (SUPER_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "slug": { "type": "string" },
                  "address": { "type": "string" },
                  "cep": { "type": "string" },
                  "neighborhood": { "type": "string" },
                  "city": { "type": "string" },
                  "state": { "type": "string" },
                  "timezone": { "type": "string" },
                  "phone": { "type": "string" },
                  "adminEmail": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Barbearia criada" }
        }
      }
    },
    "/barbershops/{id}/status": {
      "patch": {
        "summary": "Ativar/desativar barbearia (SUPER_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status atualizado" }
        }
      }
    },
    "/barbershops/{id}/profile": {
      "patch": {
        "summary": "Editar perfil (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string" },
                  "address": { "type": "string" },
                  "cep": { "type": "string" },
                  "neighborhood": { "type": "string" },
                  "city": { "type": "string" },
                  "state": { "type": "string" },
                  "timezone": { "type": "string" },
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" },
                  "primaryColor": { "type": "string", "description": "Cor primária (hex: #RRGGBB)" },
                  "secondaryColor": { "type": "string", "description": "Cor secundária (hex: #RRGGBB)" },
                  "instagramUrl": { "type": "string", "format": "uri" },
                  "whatsappUrl": { "type": "string", "format": "uri" },
                  "facebookUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Perfil atualizado" }
        }
      }
    },
    "/barbershops/{id}/operating-hours": {
      "put": {
        "summary": "Substituir grade de horários (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dayOfWeek": { "type": "integer" },
                    "startTime": { "type": "string" },
                    "endTime": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Horários atualizados" }
        }
      }
    },
    "/barbershops/{id}/blocked-dates": {
      "post": {
        "summary": "Bloquear datas (preview + confirm, BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          },
          {
            "name": "confirm",
            "in": "query",
            "description": "false ou ausente = preview, true = confirma e persiste",
            "schema": { "type": "boolean" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "startDate": { "type": "string" },
                  "endDate": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Preview ou confirmação do bloqueio" }
        }
      }
    },
    "/barbershops/{id}/blocked-dates/{blockedDateId}": {
      "delete": {
        "summary": "Remover data bloqueada (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": { "type": "string" }
          },
          {
            "name": "blockedDateId",
            "in": "path",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Data bloqueada removida" }
        }
      }
    },
    "/barbershops/{id}/gallery": {
      "post": {
        "summary": "Adicionar imagem na galeria (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageUrl": { "type": "string", "format": "uri" },
                  "caption": { "type": "string", "maxLength": 200 },
                  "sortOrder": { "type": "integer", "default": 0 }
                },
                "required": ["imageUrl"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Imagem adicionada" }
        }
      }
    },
    "/barbershops/{id}/gallery/reorder": {
      "put": {
        "summary": "Reordenar galeria (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageIds": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["imageIds"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Galeria reordenada" }
        }
      }
    },
    "/barbershops/{id}/gallery/{imageId}": {
      "delete": {
        "summary": "Remover imagem da galeria (BARBERSHOP_ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "imageId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Imagem removida" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "slug": { "type": "string" },
              "primaryColor": { "type": "string", "nullable": true },
              "secondaryColor": { "type": "string", "nullable": true },
              "instagramUrl": { "type": "string", "nullable": true },
              "whatsappUrl": { "type": "string", "nullable": true },
              "facebookUrl": { "type": "string", "nullable": true },
              "gallery": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "imageUrl": { "type": "string" },
                    "caption": { "type": "string", "nullable": true },
                    "sortOrder": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
