{
  "openapi": "3.1.0",
  "info": {
    "title": "commission",
    "description": "Endpoints de comissões por barbeiro (Fase 9). Requer token de autenticação. Use <<SERVER_URL>> como variável de ambiente no Hoppscotch.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "<<SERVER_URL>>",
      "description": "Base URL configurada no Hoppscotch"
    }
  ],
  "paths": {
    "/barbershops/{id}/commissions": {
      "get": {
        "summary": "Listar comissões da barbearia",
        "description": "Retorna resumo por barbeiro com valores pendentes e pagos. Requer token BARBERSHOP_ADMIN ou SUPER_ADMIN.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID da barbearia"
          },
          {
            "name": "barberId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filtrar por barbeiro específico"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["PENDING", "PAID"] },
            "description": "Filtrar por status"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Data início (YYYY-MM-DD)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Data fim (YYYY-MM-DD)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 },
            "description": "Número da página"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "maximum": 100 },
            "description": "Itens por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo de comissões por barbeiro",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BarberCommissionSummary" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/staff/me/commissions": {
      "get": {
        "summary": "Minhas comissões",
        "description": "Barbeiro vê suas próprias comissões com totais. Requer token BARBER ou BARBERSHOP_ADMIN.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Data início (YYYY-MM-DD)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Data fim (YYYY-MM-DD)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["PENDING", "PAID"] },
            "description": "Filtrar por status"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes das comissões do barbeiro autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/BarberCommissionDetail" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/barbershops/{id}/commissions/pay": {
      "post": {
        "summary": "Pagar comissões",
        "description": "Admin registra pagamento de comissões pendentes. Paga de um barbeiro específico ou todas de uma vez. Requer token BARBERSHOP_ADMIN.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID da barbearia"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PayCommissionsInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pagamento registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/PayCommissionsResponse" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CommissionEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "CUID da entrada" },
          "barbershopId": { "type": "string", "description": "ID da barbearia" },
          "staffMemberId": { "type": "string", "description": "ID do barbeiro" },
          "appointmentId": { "type": "string", "description": "ID do agendamento" },
          "commissionPercent": { "type": "number", "description": "Percentual aplicado" },
          "priceAtBooking": { "type": "number", "description": "Valor do serviço no momento do agendamento" },
          "amount": { "type": "number", "description": "Valor da comissão calculado" },
          "status": { "type": "string", "enum": ["PENDING", "PAID"], "description": "Status da comissão" },
          "paidAt": { "type": "string", "nullable": true, "description": "Data do pagamento" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "BarberCommissionSummary": {
        "type": "object",
        "properties": {
          "staffMemberId": { "type": "string", "description": "ID do barbeiro" },
          "name": { "type": "string", "description": "Nome do barbeiro" },
          "commissionPercent": { "type": "number", "nullable": true, "description": "Percentual de comissão configurado" },
          "pendingAmount": { "type": "number", "description": "Valor total pendente" },
          "paidThisMonth": { "type": "number", "description": "Valor pago no mês atual" },
          "pendingEntries": { "type": "integer", "description": "Quantidade de entradas pendentes" },
          "paidEntriesThisMonth": { "type": "integer", "description": "Quantidade de entradas pagas no mês" }
        }
      },
      "BarberCommissionDetail": {
        "type": "object",
        "properties": {
          "commissionPercent": { "type": "number", "nullable": true, "description": "Percentual de comissão do barbeiro" },
          "totalGenerated": { "type": "number", "description": "Total gerado (histórico completo)" },
          "pendingAmount": { "type": "number", "description": "Valor pendente" },
          "paidAmount": { "type": "number", "description": "Valor já pago" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "appointmentId": { "type": "string" },
                "serviceName": { "type": "string" },
                "amount": { "type": "number" },
                "status": { "type": "string", "enum": ["PENDING", "PAID"] },
                "createdAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "PayCommissionsInput": {
        "type": "object",
        "properties": {
          "staffMemberId": {
            "type": "string",
            "description": "Paga comissões de um barbeiro específico"
          },
          "payAll": {
            "type": "boolean",
            "description": "Ignora staffMemberId e paga todas as pendências"
          },
          "note": {
            "type": "string",
            "maxLength": 255,
            "description": "Observação opcional do pagamento"
          }
        }
      },
      "PayCommissionsResponse": {
        "type": "object",
        "properties": {
          "paymentId": { "type": "string", "description": "ID do pagamento registrado" },
          "amount": { "type": "number", "description": "Valor total pago" },
          "paidAt": { "type": "string", "format": "date-time", "description": "Data do pagamento" }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Erro de validação (Zod)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Dados inválidos" },
                "code": { "type": "string", "example": "VALIDATION_ERROR" },
                "details": { "type": "object" }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token ausente, inválido ou expirado",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Token inválido ou ausente" },
                "code": { "type": "string", "example": "UNAUTHORIZED" },
                "details": { "type": "object" }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Permissão insuficiente",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Permissão insuficiente" },
                "code": { "type": "string", "example": "FORBIDDEN" },
                "details": { "type": "object" }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Comissão não encontrada" },
                "code": { "type": "string", "example": "COMMISSION_ENTRY_NOT_FOUND" },
                "details": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
